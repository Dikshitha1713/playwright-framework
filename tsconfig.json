
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true
  },
  "include": [
    "pages/**/*.ts",
    "tests/**/*.ts",
    "testing/**/*.ts",
    "ultils/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "allure-results"
  ]
}